# Placeholders only. NEVER commit a real .env. On GCP these come from Secret Manager.

# mock | localnet | devnet | mainnet   (default: mock — in-process simulated chain)
TRADER_MODE=mock
BIND_ADDR=127.0.0.1:8080

# Required outside mock mode. Use a free/public endpoint for devnet; for
# mainnet use any RPC you are entitled to (no paid plan is assumed).
RPC_URL=
# Postgres (required on mainnet; MemStore is used when unset — data lost on restart)
# Local, no Docker: scripts/postgres-wsl.sh up  (port 5433)
# Supabase: shared pooler SESSION-mode string (port 5432, IPv4) + ?sslmode=require
#           transaction pooler (6543): also add &statement-cache-capacity=0
DATABASE_URL=postgres://trader:trader@127.0.0.1:5433/trader
# Durable pool (SIGNED and later). Size to orders in flight; clamped to server max_connections - 10.
DATABASE_MAX_CONNECTIONS=16
# Pre-sign pool (synchronous_commit=off). Default: half the durable pool.
DATABASE_PRESIGN_MAX_CONNECTIONS=8
DATABASE_MIN_CONNECTIONS=4
# false = every order write durable (single pool)
DATABASE_ASYNC_PRESIGN_COMMITS=true

# trader-cli mainnet-canary only (not used by the API server). Default:
# %USERPROFILE%\.trader\canary-keypair.json, created by `trader-cli keygen`.
# Never put the keypair file inside the repo.
CANARY_KEYPAIR=

# 32 random bytes, base64. Wraps per-wallet data keys (AES-256-GCM). Required outside mock.
#   openssl rand -base64 32
KEK_BASE64=
KEK_ID=local-env-1

# Telegram (optional in mock). Webhook secret must be >= 24 chars.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org
# Public HTTPS origin (Mini App button + webhook URL). Example: https://bot.example.com
PUBLIC_URL=
TELEGRAM_SET_WEBHOOK=false
# Comma-separated Telegram user ids allowed to trade (private beta). Empty = everyone (non-mainnet only).
BETA_ALLOWLIST_TELEGRAM_IDS=

# Mini App static export (apps/telegram-webapp/out)
MINIAPP_DIR=apps/telegram-webapp/out
CORS_ORIGIN=

# Private endpoints (/metrics, /v1/provider-health)
ADMIN_TOKEN=

# Optional senders (off by default). Tips are paid in SOL from the trader's wallet.
JITO_BLOCK_ENGINE_URL=
JITO_BUNDLE_ONLY=false
JITO_RPS=1
HELIUS_SENDER_URL=
HELIUS_SWQOS_ONLY=true

# Never set on mainnet in this build (config validation refuses it).
SKIP_PREFLIGHT=false
OBSERVER_POLL_MS=250
MOCK_SLOT_MS=400

# Mainnet order submission stays OFF unless this exact phrase is set AND each
# wallet's policy has mainnet_enabled=true (operator action). See docs/RUNBOOK.md.
MAINNET_TRADING_ENABLED=
RUST_LOG=info,sqlx=warn
